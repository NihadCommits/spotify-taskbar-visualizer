<Window x:Class="SpotifyTaskbarVisualizer.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spotify Taskbar Visualizer" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="Segoe UI" FontSize="12">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <!-- Near-transparent background keeps the button clickable on a transparent window. -->
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="#01000000" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#20FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#10FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Time" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <!-- Root height is set to the taskbar height in code. Near-transparent so the whole widget takes the right-click. -->
    <Grid x:Name="Root" Background="#01000000">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Exit" Click="Exit_Click" />
            </ContextMenu>
        </Grid.ContextMenu>
        <StackPanel Orientation="Horizontal" TextElement.Foreground="White" Margin="8,0" VerticalAlignment="Center">
            <!-- Cover and title: a click brings Spotify to the front. -->
            <StackPanel x:Name="TrackArea" Orientation="Horizontal" Background="#01000000" Cursor="Hand"
                        MouseLeftButtonUp="TrackArea_MouseLeftButtonUp">
                <Image x:Name="CoverImage" Width="32" Height="32" />
                <StackPanel Width="160" Margin="8,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ArtistText" FontSize="11" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>
            <Button x:Name="ShuffleButton" Content="&#xE8B1;" Click="Shuffle_Click" />
            <Button Content="&#xE892;" Click="Previous_Click" />
            <Button x:Name="PlayPauseButton" Content="&#xE768;" Click="PlayPause_Click" />
            <Button Content="&#xE893;" Click="Next_Click" />
            <Button x:Name="RepeatButton" Content="&#xE8EE;" Click="Repeat_Click" />
            <TextBlock x:Name="PositionText" Style="{StaticResource Time}" Margin="8,0,6,0" />
            <!-- Taller click area around the thin bar for seeking. -->
            <Border x:Name="SeekArea" Width="120" Height="20" Background="#01000000" VerticalAlignment="Center"
                    MouseLeftButtonDown="SeekArea_MouseLeftButtonDown">
                <ProgressBar x:Name="Progress" Height="4" Maximum="1" VerticalAlignment="Center"
                             Background="#40FFFFFF" Foreground="White" BorderThickness="0" />
            </Border>
            <TextBlock x:Name="DurationText" Style="{StaticResource Time}" Margin="6,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
